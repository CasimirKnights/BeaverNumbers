import BeaverStructural.BB6.Decimal200ResidueTable
namespace BeaverStructural.BB6.Decimal200
set_option compiler.extract_closed false
set_option maxRecDepth 100000
set_option maxHeartbeats 1000000

private theorem sum_table {m : ℕ} (C : TowerModulus m) (k a offset nr : ℕ)
    (f : ℕ → ℕ) (hk : C.depth+2=k) (ha : C.steady=a)
    (hf : ∀ h, C.residue h=f h) :
    C.sumCode offset nr=((∑ i ∈ Finset.range k, f (offset+i))+(nr+k*m-k)*a)%m := by
  unfold TowerModulus.sumCode
  rw [hk,ha]
  simp_rw [hf]

private theorem power_table {m : ℕ} (C : TowerModulus m) (k a offset nr pow : ℕ)
    (f : ℕ → ℕ) (hk : C.depth+2=k) (ha : C.steady=a)
    (hf : ∀ h, C.residue h=f h) :
    C.powerCode offset nr pow=((∑ i ∈ Finset.range k, (f (offset+i))^pow)+(nr+k*m-k)*a^pow)%m := by
  unfold TowerModulus.powerCode
  rw [hk,ha]
  simp_rw [hf]

private theorem weighted_table {m : ℕ} (C : TowerModulus m) (k a offset nr : ℕ)
    (f : ℕ → ℕ) (hk : C.depth+2=k) (ha : C.steady=a)
    (hf : ∀ h, C.residue h=f h) :
    C.weightedCode offset nr=(2*(∑ i ∈ Finset.range k, (nr+k*m-i)*f (offset+i))+(nr+k*m-k)*(nr+k*m-k+1)*a)%m := by
  unfold TowerModulus.weightedCode
  rw [hk,ha]
  simp_rw [hf]

private theorem decimal_prefix_depth : decimal.depth+2=203 :=
  congrArg (fun n : ℕ => n+2) decimal_depth_numeric

attribute [local irreducible] TowerModulus.sumCode TowerModulus.powerCode TowerModulus.weightedCode

