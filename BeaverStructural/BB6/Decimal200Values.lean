private theorem sumCode_from_prefix {m : ℕ} (C : TowerModulus m) (offset nr k sr ar : ℕ)
    (hd : C.depth+2=k) (hs : (∑ i ∈ Finset.range (C.depth+2), C.residue (offset+i))=sr)
    (ha : C.steady=ar) : C.sumCode offset nr=(sr+(nr+k*m-k)*ar)%m := by
  unfold TowerModulus.sumCode
  dsimp only
  rewrite [hs,hd,ha]
  rfl

private theorem width1Code_from_parts {m p : ℕ} (C : TowerModulus m) (P : TowerModulus p)
    (k nr tr sr ar : ℕ) (hd : C.depth+2=k)
    (hn : count1Code (m:=m) P=nr) (ht : count1Code (m:=3*m) P=tr)
    (hs : (∑ i ∈ Finset.range (C.depth+2), C.residue (8+i))=sr)
    (ha : C.steady=ar) :
    width1Code C P=(((sr+(((nr+1)%m)+k*m-k)*ar)%m)+5*(tr/3)+2)%m := by
  unfold width1Code
  rewrite [hn,ht,sumCode_from_prefix C 8 _ k sr ar hd hs ha]
  rfl

private theorem count2Code_from_parts {m p q : ℕ} (P : TowerModulus p) (Q : TowerModulus q)
    (sr ar : ℕ) (hs : seedWidthCode P=sr) (ha : width1Code P Q=ar) :
    count2Code (m:=m) P Q=
      (((powCode (m:=m) P ((sr+7)%p)+m-1)%m)*powCode (m:=m) P ar+m-1)%m := by
  unfold count2Code
  rewrite [hs,ha]
  rfl

