attribute [local irreducible] tower towerSum exhaustedWidth exhaustedRight resetCounter stage1 stage2

private theorem stage1_reset : stage1=resetCounter seed := by unfold stage1; rfl
private theorem stage2_reset : stage2=resetCounter stage1 := by unfold stage2; rfl

private theorem reset_length_transfer (C : Counter) (m L a : ℕ)
    (hL : C.length%m=L) (ha : exhaustedWidth C%m=a) :
    (resetCounter C).length%m=(L+a+2)%m := by
  rewrite [resetCounter_length]
  simp only [Nat.add_mod,hL,ha,Nat.mod_mod]

private theorem reset_population_transfer (C : Counter) (m L a : ℕ)
    (hL : C.length%m=L) (ha : exhaustedWidth C%m=a) :
    binaryPopulation (resetCounter C).count%m=(L+a+1)%m := by
  rewrite [resetCounter_population]
  simp only [Nat.add_mod,hL,ha,Nat.mod_mod]

private theorem carry_transfer (n m nr pr : ℕ) (hm : 0<m)
    (hn : n%m=nr) (hp : binaryPopulation n%m=pr) :
    binaryCarry n%m=ModularClock.modSub m nr pr :=
  ModularClock.modSub_correct m n (binaryPopulation n) nr pr hm (population_le n) hn hp

private theorem quotient_three_transfer (n m r : ℕ) (hr : n%(3*m)=r) :
    (n/3)%m=r/3 := by
  rw [← Nat.mod_mul_right_div_self, hr]

private theorem sum_succ_transfer (n b m sr nr r : ℕ)
    (hs : towerSum (n+1) b%m=(((n+1)%m)*sr)%m)
    (hn : n%m=nr) (hr : sr=r) :
    towerSum (n+1) b%m=((nr+1)*r)%m := by
  rewrite [hr] at hs
  simpa only [Nat.add_mod,Nat.mul_mod,hn,Nat.mod_mod] using hs

private theorem width_two_transfer (C : Counter) (m sr dr : ℕ)
    (hs : towerSum (C.count+1) C.base%m=sr)
    (hd : (C.count/3)%m=dr) (hr : C.count%3=2) :
    exhaustedWidth C%m=(sr+5*dr+4)%m := by
  rewrite [exhaustedWidth,hr]
  simp only [show ¬(2:ℕ)=1 by decide,if_false,Nat.add_mod,Nat.mul_mod,hs,hd,Nat.mod_mod]

private theorem counter_width_transfer (D : Counter) (m sr nr tr r : ℕ)
    (hs : towerSum (D.count+1) (tower 0 D.base)%m=(((D.count+1)%m)*sr)%m)
    (hn : D.count%m=nr) (htr : D.count%(3*m)=tr)
    (hr : sr=r) (hmode : D.count%3=2) :
    exhaustedWidth D%m=((nr+1)*r+5*(tr/3)+4)%m := by
  simp only [tower_zero] at hs
  have ht := sum_succ_transfer D.count D.base m sr nr r hs hn hr
  have hd := quotient_three_transfer D.count m tr htr
  have hw := width_two_transfer D m _ _ ht hd hmode
  simpa only [Nat.add_mod,Nat.mod_mod] using hw

